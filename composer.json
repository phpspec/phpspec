{
    "name": "phpspec/phpspec",
    "description": "Specification-oriented BDD framework for PHP 8.3+",
    "keywords": ["BDD", "SpecBDD", "TDD", "spec", "specification", "tests", "testing"],
    "homepage": "http://phpspec.net/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Konstantin Kudryashov",
            "email": "ever.zet@gmail.com",
            "homepage": "http://everzet.com"
        },
        {
            "name": "Marcello Duarte",
            "homepage": "http://marcelloduarte.net/"
        },
        {
            "name": "Ciaran McNulty",
            "homepage": "https://ciaranmcnulty.com/"
        }
    ],

    "require": {
        "php": "8.3.* || 8.4.* || 8.5.* || 8.6.*",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/yaml": "^7.4.23 || ^8.1.11",
        "cucumber/gherkin": "^39.0",
        "ext-mbstring": "*",
        "ext-tokenizer": "*",
        "ext-sockets": "*"
    },

    "autoload": {
        "psr-0": {
            "PhpSpec": "src/"
        },
        "files": [
            "src/PhpSpec/functions.php",
            "src/PhpSpec/Mock/functions.php",
            "src/PhpSpec/StoryBDD/functions.php",
            "src/PhpSpec/Browser/functions.php"
        ]
    },

    "suggest": {
        "papi-ai/papi-core": "Required for AI features (pair, next, generate, refactor); ^0.15.4 or newer",
        "papi-ai/google": "Google Gemini AI provider; ^0.17.1 or newer",
        "papi-ai/anthropic": "Anthropic Claude AI provider; ^0.17.1 or newer",
        "papi-ai/openai": "OpenAI GPT AI provider; ^0.17.1 or newer",
        "papi-ai/azure-openai": "Azure OpenAI AI provider; ^0.16.1 or newer",
        "papi-ai/grok": "xAI Grok AI provider; ^0.17.1 or newer",
        "papi-ai/deepseek": "DeepSeek AI provider; ^0.17.1 or newer",
        "papi-ai/mistral": "Mistral AI provider; ^0.16.2 or newer",
        "papi-ai/groq": "Groq AI provider; ^0.16.2 or newer",
        "papi-ai/cohere": "Cohere AI provider; ^0.16.2 or newer",
        "papi-ai/ollama": "Local models through Ollama; ^0.16.1 or newer",
        "ext-curl": "Required for AI features (pair, next, generate, refactor)",
        "ext-dom": "For JUnit XML and Clover coverage reports",
        "ext-pcov": "For code coverage, or ext-xdebug",
        "ext-xdebug": "For code coverage, or ext-pcov",
        "ext-posix": "For terminal width detection",
        "ext-readline": "For interactive pair mode"
    },

    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "papi-ai/papi-core": "^0.15.4",
        "psr/http-message": "^2.0"
    },

    "conflict": {
        "papi-ai/papi-core": "<0.15.4",
        "papi-ai/google": "<0.17.1",
        "papi-ai/anthropic": "<0.17.1",
        "papi-ai/openai": "<0.17.1",
        "papi-ai/azure-openai": "<0.16.1",
        "papi-ai/grok": "<0.17.1",
        "papi-ai/deepseek": "<0.17.1",
        "papi-ai/mistral": "<0.16.2",
        "papi-ai/groq": "<0.16.2",
        "papi-ai/cohere": "<0.16.2",
        "papi-ai/ollama": "<0.16.1"
    },

    "bin": ["bin/phpspec"],

    "extra": {
        "branch-alias": {
            "dev-main": "9.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
